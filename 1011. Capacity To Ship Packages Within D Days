class Solution {
public:
    bool solve(vector<int>&w,int d,int m,int n) {
        int cnt = 1;//to ensure last remaining elements to be counted
        long long sum = 0;
        for(int i=0;i<n;i++) {
            sum+=w[i];
            if(sum>m) {
                cnt++;
                sum = w[i];
            }
        }
        return cnt<=d;
    }
    int shipWithinDays(vector<int>& weights, int days) {
        int n = weights.size();
        int low = *max_element(weights.begin(),weights.end());
        int high = accumulate(weights.begin(),weights.end(),0);
        while(low<=high) {
            int mid = low+(high-low)/2;
            if(solve(weights,days,mid,n)) {
                high = mid-1;
            }
            else {
                low = mid+1;
            }
        }
        return low;
    }
};
