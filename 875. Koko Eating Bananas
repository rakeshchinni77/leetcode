class Solution {
private:
    // Helper function using efficient integer arithmetic
    long long calculateTotalHours(const vector<int>& piles, int speed) {
        long long totalH = 0;
        for (int bananas : piles) {
            // Integer equivalent of ceil((double)bananas / speed)
            totalH += (bananas + speed - 1) / speed;
        }
        return totalH;
    }

public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1;
        int high = *max_element(piles.begin(), piles.end());
        int ans = high;

        while (low <= high) {
            // Prevents integer overflow
            int mid = low + (high - low) / 2; 
            
            if (calculateTotalHours(piles, mid) <= h) {
                ans = mid;
                high = mid - 1; // Look for a smaller valid speed
            } else {
                low = mid + 1;  // Speed is too slow, increase it
            }
        }
        return ans;
    }
};
