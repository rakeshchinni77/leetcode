class Solution {
public:
    bool solve(vector<int>&nums,int t,int mid,int n) {
        long long sum = 0;
        for(int i=0;i<n;i++) {
            sum+=ceil((double)nums[i]/mid);
        }
        return sum<=t;
    }
    int smallestDivisor(vector<int>& nums, int t) {
        int n = nums.size();
        if(n>t) return -1;
        int low = 1;
        int high = *max_element(nums.begin(),nums.end());
        while(low<=high) {
            int mid = low+(high-low)/2;
            if(solve(nums,t,mid,n)) {
                high = mid-1;
            }
            else {
                low = mid+1;
            }
        }
        return low;
    }
};
