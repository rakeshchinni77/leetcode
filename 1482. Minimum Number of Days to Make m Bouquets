class Solution {
public:
    bool solve(vector<int>& arr,int n,int mid,int m,int k) {
        int adj = 0,cnt = 0;
        for(int i=0;i<n;i++) {
            if(arr[i]<=mid) {
                adj++;
                if(adj == k) {
                    cnt++;
                    adj=0;
                }
            }
            else adj = 0;
        }
        return (cnt >= m);
    }
    int minDays(vector<int>& bloomDay, int m, int k) {
        int n = bloomDay.size();
        if((long long)m*k > n) return -1;
        int low = *min_element(bloomDay.begin(),bloomDay.end());
        int high = *max_element(bloomDay.begin(),bloomDay.end());
        while(low<=high) {
            int mid = low+(high-low)/2;
            if(solve(bloomDay,n,mid,m,k)) {
                high = mid-1;
            }
            else {
                low = mid+1;
            }
        }
        return low;
    }
};
