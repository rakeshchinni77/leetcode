class Solution {
    
public:
    bool solve(vector<int>& piles,int mid,int n,int h) {
        long long temp_cnt = 0;
        for(int i=0;i<n;i++) {
            temp_cnt+=ceil((double)piles[i]/mid);
            if(temp_cnt>h) return false;
        }
        return true;
    }
    int minEatingSpeed(vector<int>& piles, int h) {
        int maxi = *max_element(piles.begin(),piles.end());
        int n = piles.size();
        int low=1,high=maxi;
        while(low<=high) {
            int mid = low+(high-low)/2;
            if(solve(piles,mid,n,h)) {
                high = mid-1;
            }
            else low = mid+1;
        }
        return low;
    }
};
